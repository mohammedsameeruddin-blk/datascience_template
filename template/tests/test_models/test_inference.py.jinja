import pytest
import pandas as pd
from {{ project }}.models.{{ model }}.inference.scoring import BatchScoring


class TestBatchScoring:
    def test_instantiation(self):
        scorer = BatchScoring()
        assert scorer is not None

    def test_has_required_methods(self):
        scorer = BatchScoring()
        assert hasattr(scorer, "load")
        assert hasattr(scorer, "prepare_features")
        assert hasattr(scorer, "score")
        assert hasattr(scorer, "run")

    def test_run_returns_dataframe(self, sample_dataframe, mocker):
        scorer = BatchScoring()
        mocker.patch.object(scorer, "load", return_value=sample_dataframe)
        mocker.patch.object(scorer, "prepare_features", return_value=sample_dataframe)
        mocker.patch.object(scorer, "score", return_value=sample_dataframe)
        result = scorer.run()
        assert isinstance(result, pd.DataFrame)