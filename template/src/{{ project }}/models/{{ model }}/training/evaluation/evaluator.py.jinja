from copy import deepcopy

import numpy as np
from sklearn.model_selection import KFold

from ...config.hyper_config import config
from ..model_utils import feature_scaling, ml_metrics


def evaluate_model(
    model_cls,
    best_params,
    X,
    y,
    tuning_params,
):
    """
    Evaluate a trained model using outer cross-validation.

    This function performs model evaluation using K-Fold cross-validation
    with the best hyperparameters obtained from tuning. It supports both
    classification and regression based on the global configuration.

    Args:
        model_cls: Model class or initialized model object to be evaluated.
        best_params (dict): Best hyperparameters obtained from tuning.
        X (pd.DataFrame): Feature dataframe.
        y (pd.Series): Target variable.
        tuning_params (dict): Dictionary containing evaluation parameters such
            as number of folds and random seed.

    Returns:
        dict: Evaluation results containing:
            - model_type (str): Type of model (classification or regression)
            - folds (list): Per-fold evaluation metrics
            - mean_metrics (dict): Mean metrics across folds
            - selection_metric (str): Metric used for model selection
            - selection_metric_value (float): Mean value of selection metric
    """
    model_type = config["model_type"]
    selection_metric = config["model_params"]["selection_metric"]

    cv = KFold(
        n_splits=tuning_params["k_outer"],
        shuffle=True,
        random_state=tuning_params["seed"],
    )

    fold_results = []
    metrics_store = {
        "accuracy": [],
        "precision": [],
        "recall": [],
        "f1_macro": [],
        "f1_weighted": [],
        "roc_auc": [],
        "mae": [],
        "mse": [],
        "mape": [],
        "r2": [],
    }

    for fold_idx, (train_idx, test_idx) in enumerate(cv.split(X), start=1):
        X_train = X.iloc[train_idx].copy()
        X_test = X.iloc[test_idx].copy()
        y_train = y.iloc[train_idx]
        y_test = y.iloc[test_idx]

        X_train, X_test, _ = feature_scaling(X_train, X_test)

        model = deepcopy(model_cls)
        model.set_params(**best_params)
        model.fit(X_train, y_train)

        y_pred = model.predict(X_test)
        m = ml_metrics(y_test, y_pred)

        if model_type == "Classification":
            fold_results.append(
                {
                    "fold": fold_idx,
                    "accuracy": m["accuracy"],
                    "precision": m["precision"],
                    "recall": m["recall"],
                    "f1_macro": m["f1_macro"],
                    "f1_weighted": m["f1_weighted"],
                    "roc_auc": m["roc_auc"],
                }
            )

            metrics_store["accuracy"].append(m["accuracy"])
            metrics_store["precision"].append(m["precision"])
            metrics_store["recall"].append(m["recall"])
            metrics_store["f1_macro"].append(m["f1_macro"])
            metrics_store["f1_weighted"].append(m["f1_weighted"])
            metrics_store["roc_auc"].append(m["roc_auc"])

        else:  # regression
            fold_results.append(
                {
                    "fold": fold_idx,
                    "mae": m["mae"],
                    "r2": m["r2"],
                    "mse": m["mse"],
                    "mape": m["mape"],
                }
            )

            metrics_store["mae"].append(m["mae"])
            metrics_store["r2"].append(m["r2"])
            metrics_store["mse"].append(m["mse"])
            metrics_store["mape"].append(m["mape"])

    mean_metrics = {
        f"mean_{k}": float(np.mean(v)) for k, v in metrics_store.items() if v
    }

    return {
        "model_type": model_type,
        "folds": fold_results,
        "mean_metrics": mean_metrics,
        "selection_metric": selection_metric,
        "selection_metric_value": mean_metrics[f"mean_{selection_metric}"],
    }
