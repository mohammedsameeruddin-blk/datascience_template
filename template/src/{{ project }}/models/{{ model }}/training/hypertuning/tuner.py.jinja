from functools import partial
from pydoc import locate

import catboost  # noqa: F401
import optuna
import pandas as pd
import sklearn  # noqa: F401
import xgboost  # noqa: F401

from ...config.hyper_config import METRIC_DIRECTION
from ...config.hyper_config import config as hyper_config
from .objective import optuna_objective

optuna.logging.set_verbosity(optuna.logging.WARNING)


class HyperparameterTuner:
    """
    Generic hyperparameter tuner using Optuna (TPE sampler).

    Expects `config["models"]` entries to include:
        - name (str): Human-readable model name
        - model (str | object): Model class or import path
        - hyperparameters (dict): Optuna space spec
            (each value is {"type": ..., ...}, see hyper_config.py)
        - tuning_param / tuning_params (dict): Tuning configuration
            (max_iter, k_inner, seed)

    The results dict shape is identical to the Hyperopt tuner so the
    MLOps layer requires no changes when switching between the two.
    """

    def __init__(self, train_df: pd.DataFrame, config: dict | None = None):
        """
        Initialize the HyperparameterTuner.

        Args:
            train_df (pd.DataFrame): Training dataset.
            config (dict, optional): Configuration dictionary.
                Defaults to hyper_config.

        Raises:
            AssertionError: If configuration is None.
        """
        self.config = config or hyper_config
        assert self.config is not None, "Configuration cannot be None"
        self.train_df = train_df

    def _resolve_model(self, model_spec):
        """
        Resolve model specification into a callable model class or object.

        Args:
            model_spec (str | object): Model class or import path.

        Returns:
            object: Resolved model class or instance.
        """
        if isinstance(model_spec, str):
            cls_or_obj = locate(model_spec)
            if cls_or_obj is None:
                cls_or_obj = eval(model_spec)  # legacy fallback
            return cls_or_obj
        return model_spec

    def run(self) -> dict:
        """
        Execute hyperparameter tuning for all configured models.

        Returns:
            dict: Dictionary keyed by model name containing:
                - best_params (dict)
                - best_loss (float)
                - trials (list): one entry per trial, each with:
                    - loss (float)
                    - status (str)
                    - selection_metric (str)
                    - selection_metric_value (float)
                    - metrics (dict)
                    - params (dict)
        """
        results = {}

        X = self.train_df.drop(self.config["model_params"]["redu_col"], axis=1)
        y = self.train_df[self.config["model_params"]["target"]]

        for model_key, model_cfg in self.config["models"].items():
            model_name = model_cfg.get("name", model_key)
            model_spec = model_cfg.get("model")

            assert model_spec is not None, (
                f"Model specification missing for {model_name}"
            )

            model_cls = self._resolve_model(model_spec)

            hyperparameters = model_cfg.get("hyperparameters", {})
            tuning_params = (
                model_cfg.get("tuning_params") or model_cfg.get("tuning_param") or {}
            )

            selection_metric = self.config["model_params"]["selection_metric"]
            _dir = METRIC_DIRECTION[selection_metric]  # "max" or "min"
            direction = "maximize" if _dir == "max" else "minimize"

            study = optuna.create_study(
                direction=direction,
                sampler=optuna.samplers.TPESampler(seed=tuning_params.get("seed", 42)),
            )

            objective_fn = partial(
                optuna_objective,
                model_cls=model_cls,
                X=X,
                y=y,
                tuning_params=tuning_params,
                hyperparameters=hyperparameters,
            )

            study.optimize(objective_fn, n_trials=tuning_params.get("max_iter", 50))

            # Reconstruct the same trials list shape as the Hyperopt tuner.
            # The objective stores all extra data via trial.set_user_attr().
            trial_results = [
                {
                    "loss": t.value,
                    "status": "ok",
                    "selection_metric": t.user_attrs.get("selection_metric"),
                    "selection_metric_value": t.user_attrs.get(
                        "selection_metric_value"
                    ),
                    "metrics": t.user_attrs.get("metrics"),
                    "params": t.user_attrs.get("params"),
                }
                for t in study.trials
            ]

            results[model_name] = {
                "best_params": study.best_params,
                "best_loss": study.best_value,
                "trials": trial_results,
            }

        return results
