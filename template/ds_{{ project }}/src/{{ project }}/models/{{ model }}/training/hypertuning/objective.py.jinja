import numpy as np
from copy import deepcopy
from sklearn.model_selection import KFold
from ..model_utils import ml_metrics
from ..model_utils import feature_scaling
from ...config.hyper_config import config, METRIC_DIRECTION


def hyperopt_objective(
    params,
    model_cls,
    X,
    y,
    tuning_params,
):
    """
    Objective function for hyperparameter optimization.

    This function performs inner cross-validation using the provided
    hyperparameters, evaluates model performance based on the configured
    selection metric, and returns a loss value for optimization.

    Args:
        params (dict): Hyperparameters to evaluate for the model.
        model_cls: Uninitialized model class or estimator template.
        X (pd.DataFrame): Feature matrix.
        y (pd.Series): Target variable.
        tuning_params (dict): Dictionary containing tuning configuration,
            including number of inner folds and random seed.

    Returns:
        dict: Dictionary containing:
            - loss (float): Optimization loss value.
            - status (str): Optimization status (e.g., "ok").
            - selection_metric (str): Metric used for optimization.
            - selection_metric_value (float): Mean value of the selection metric.
            - metrics (dict): Mean cross-validation metrics.
            - params (dict): Evaluated hyperparameters.
    """
    model_type = config.get("model_type")
    selection_metric = config["model_params"]["selection_metric"]

    cv = KFold(
        n_splits=tuning_params["k_inner"],
        shuffle=True,
        random_state=tuning_params["seed"],
    )

    metrics_store = {
        "accuracy": [],
        "precision": [],
        "recall": [],
        "roc_auc": [],
        "mae": [],
        "mse": [],
        "mape": [],
        "r2": [],
    }

    for train_idx, val_idx in cv.split(X):
        X_train = X.iloc[train_idx].copy()
        X_val = X.iloc[val_idx].copy()
        y_train = y.iloc[train_idx]
        y_val = y.iloc[val_idx]

        X_train, X_val, _ = feature_scaling(X_train, X_val)

        model = deepcopy(model_cls)
        model.set_params(**params)
        model.fit(X_train, y_train)

        if model_type == "classification":
            y_pred = model.predict(X_val)
            accu, prec, rec, roc_auc = ml_metrics(y_val, y_pred)

            metrics_store["accuracy"].append(accu)
            metrics_store["precision"].append(prec)
            metrics_store["recall"].append(rec)
            metrics_store["roc_auc"].append(roc_auc)

        else:
            y_pred = model.predict(X_val)
            mae, r2, mse, mape = ml_metrics(y_val, y_pred)

            metrics_store["mae"].append(mae)
            metrics_store["r2"].append(r2)
            metrics_store["mse"].append(mse)
            metrics_store["mape"].append(mape)

    # Aggregation
    mean_metrics = {
        k: float(np.mean(v)) for k, v in metrics_store.items() if v
    }

    selected_value = mean_metrics[selection_metric]

    # Calculate loss
    direction = METRIC_DIRECTION.get(selection_metric)
    if direction is None:
        raise ValueError(f"Unsupported selection_metric: {selection_metric}")

    if direction == "max":
        loss = 1 - selected_value  # maximize
    else:
        loss = selected_value  # minimize

    return {
        "loss": loss,
        "status": "ok",
        "selection_metric": selection_metric,
        "selection_metric_value": selected_value,
        "metrics": mean_metrics,
        "params": params,
    }
