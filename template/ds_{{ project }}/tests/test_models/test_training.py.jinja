import pytest
from {{ project }}.models.{{ model }}.training.train import ModelTrainer
from {{ project }}.models.{{ model }}.training.hypertuning.tuner import HyperparameterTuner
from {{ project }}.models.{{ model }}.training.evaluation.selector import ModelEvaluator


class TestModelTrainer:
    def test_instantiation(self):
        trainer = ModelTrainer()
        assert trainer is not None

    def test_has_run_method(self):
        trainer = ModelTrainer()
        assert hasattr(trainer, "run")
        assert callable(trainer.run)


