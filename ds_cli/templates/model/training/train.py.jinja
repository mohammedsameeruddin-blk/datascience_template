from copy import deepcopy
from typing import Any, Dict
from pydoc import locate

import sklearn  # noqa: F401
import xgboost  # noqa: F401
import catboost  # noqa: F401

from ..config.hyper_config import config
from .model_utils import ml_metrics, feature_scaling


class ModelTrainer:
    """
    Train the selected best model on training data and evaluate on
    both training and test datasets.
    """

    def __init__(
        self,
        train_df,
        test_df,
        model_name: str,
        best_params: Dict[str, Any],
        config: dict = config,
    ):
        """
        Initialize the ModelTrainer.

        Args:
            train_df (pd.DataFrame): Training dataset.
            test_df (pd.DataFrame): Test dataset.
            model_name (str): Name of the selected best model.
            best_params (dict): Best hyperparameters for the model.
            config (dict, optional): Configuration dictionary.
                Defaults to global config.
        """
        self.train_df = train_df
        self.test_df = test_df
        self.model_name = model_name
        self.best_params = best_params
        self.config = config

    
    def _resolve_model(self, model_spec):
        """
        Resolve model specification to a class or object.

        Args:
            model_spec (str | object): Model import path or model class.

        Returns:
            object: Resolved model class or instance.

        Raises:
            ValueError: If model cannot be resolved.
        """
        if isinstance(model_spec, str):
            cls_or_obj = locate(model_spec)
            if cls_or_obj is None:
                cls_or_obj = eval(model_spec)  # legacy fallback
            return cls_or_obj
        return model_spec

    
    def run(self) -> Dict[str, Any]:
        """
        Train the selected model and evaluate performance.

        Returns:
            dict: Dictionary containing:
                - model: Trained model object
                - scaler: Fitted scaler
                - model_name: Name of the trained model
                - params: Best model parameters
                - metrics: Train and test evaluation metrics
                - input_example: Sample input for model signature
                - feature_columns: List of feature names
                - model_type: Classification or regression
        """
        model_type = self.config["model_type"]
        target = self.config["model_params"]["target"]
        drop_cols = self.config["model_params"]["redu_col"]

        X_train = self.train_df.drop(drop_cols, axis=1)
        y_train = self.train_df[target]

        X_test = self.test_df.drop(drop_cols, axis=1)
        y_test = self.test_df[target]

        # Feature scaling
        X_train, X_test, scaler = feature_scaling(X_train, X_test)

        # Resolve model
        model_cls = None
        for model_cfg in self.config["models"].values():
            if model_cfg["name"] == self.model_name:
                model_cls = self._resolve_model(model_cfg["model"])
                break

        if model_cls is None:
            raise ValueError(f"Model '{self.model_name}' not found in config")

        model = deepcopy(model_cls)
        model.set_params(**self.best_params)
        model.fit(X_train, y_train)

        # Evaluation
        if model_type == "Classification":
            y_train_pred = model.predict(X_train)
            y_test_pred = model.predict(X_test)

            train_metrics = ml_metrics(y_train, y_train_pred)
            test_metrics = ml_metrics(y_test, y_test_pred)

            train_metrics_dict = {
                "accuracy": train_metrics[0],
                "precision": train_metrics[1],
                "recall": train_metrics[2],
                "roc_auc": train_metrics[3],
            }

            test_metrics_dict = {
                "accuracy": test_metrics[0],
                "precision": test_metrics[1],
                "recall": test_metrics[2],
                "roc_auc": test_metrics[3],
            }

        else:  # regression
            y_train_pred = model.predict(X_train)
            y_test_pred = model.predict(X_test)

            train_metrics = ml_metrics(y_train, y_train_pred)
            test_metrics = ml_metrics(y_test, y_test_pred)

            train_metrics_dict = {
                "mae": train_metrics[0],
                "r2": train_metrics[1],
                "mse": train_metrics[2],
                "mape": train_metrics[3],
            }

            test_metrics_dict = {
                "mae": test_metrics[0],
                "r2": test_metrics[1],
                "mse": test_metrics[2],
                "mape": test_metrics[3],
            }

        # Input example for MLflow signature
        input_example = X_train.head(5)

        return {
            "model": model,
            "scaler": scaler,
            "model_name": self.model_name,
            "params": self.best_params,
            "metrics": {
                "train": train_metrics_dict,
                "test": test_metrics_dict,
            },
            "input_example": input_example,
            "feature_columns": list(X_train.columns),
            "model_type": model_type,
            "X_train": X_train,
            "y_train": y_train,
            "X_test": X_test,
            "y_test": y_test,
        }
