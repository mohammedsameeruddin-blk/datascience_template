import pandas as pd
from typing import Optional
from ..config.hyper_config import config as hyper_config
from .base import BaseScorer


class BatchScoring(BaseScorer):
    """
    Batch inference class for running predictions on trained models.
    """

    model_name = "{{ model }}"

    def __init__(
        self,
        *,
        input_df: pd.DataFrame,
        model,
        scaler=None,
        config: Optional[dict] = None,
    ):
        """
        Initialize the batch scoring pipeline.

        Args:
            input_df (pd.DataFrame): Input dataframe used for batch inference.
            model: Trained model object supporting prediction.
            scaler (optional): Fitted scaler used during training.
            config (Optional[dict]): Configuration dictionary for model
                and preprocessing. Defaults to global hyper_config.
        """
        self.input_df = input_df
        super().__init__(
            model=model,
            scaler=scaler,
            config=hyper_config if config is None else config,
        )

    
    def load(self) -> pd.DataFrame:
        """
        Load input data for batch scoring.

        Args:
            None

        Returns:
            pd.DataFrame: Copy of the input dataframe.
        """
        return self.input_df.copy()

    
    def prepare_features(self, data: pd.DataFrame) -> pd.DataFrame:
        """
        Prepare features for model inference.

        This method performs lightweight preprocessing such as
        dropping unnecessary columns before scoring.

        Args:
            data (pd.DataFrame): Raw input dataframe.

        Returns:
            pd.DataFrame: Prepared dataframe ready for prediction.
        """
        df = data.copy()

        # Drop unwanted columns
        reduce_cols = self.config["model_params"].get("redu_col", [])
        if reduce_cols:
            df = df.drop(reduce_cols, axis=1, errors="ignore")

        return df
